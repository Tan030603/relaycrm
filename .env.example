# Copy to .env for local development (matches docker-compose.yml).

# Owner role: runs migrations only. Owns the tables, so never use it for app queries.
MIGRATION_DATABASE_URL=postgresql://relaycrm:relaycrm@localhost:5440/relaycrm

# app_user: non-owner, non-superuser role the API uses, so RLS always applies.
DATABASE_URL=postgresql://app_user:app_user_dev@localhost:5440/relaycrm
DB_POOL_MAX=10

JWT_SECRET=dev-only-change-me-to-a-long-random-string
PORT=4000

# Queues, rate limits, rules cache. Redis runs on 6380 locally (docker compose).
REDIS_URL=redis://localhost:6380
# Mailpit catches every email: http://localhost:8025
SMTP_URL=smtp://localhost:1025
APP_URL=http://localhost:5180

# Optional: enables the AI helper on deals and "describe a rule". Without it the
# deal helper uses a built-in summary and rule generation is disabled.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
