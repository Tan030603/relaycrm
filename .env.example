# Copy to .env for local development (matches docker-compose.yml).

# Owner role: runs migrations only. Owns the tables, so never use it for app queries.
MIGRATION_DATABASE_URL=postgresql://relaycrm:relaycrm@localhost:5440/relaycrm

# app_user: non-owner, non-superuser role the API uses, so RLS always applies.
DATABASE_URL=postgresql://app_user:app_user_dev@localhost:5440/relaycrm
DB_POOL_MAX=10

JWT_SECRET=dev-only-change-me-to-a-long-random-string
PORT=4000
