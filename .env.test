# Loaded after .env by the test script: tests use their own database and queue prefix,
# so a running dev/Docker worker never picks up their events.
MIGRATION_DATABASE_URL=postgresql://relaycrm:relaycrm@localhost:5440/relaycrm_test
DATABASE_URL=postgresql://app_user:app_user_dev@localhost:5440/relaycrm_test
QUEUE_PREFIX=test
LOG_LEVEL=warn
