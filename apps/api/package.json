{
  "name": "api",
  "private": true,
  "version": "0.1.0",
  "files": [
    "dist",
    "prisma",
    "prisma.config.ts"
  ],
  "scripts": {
    "generate": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.json",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "start": "node dist/src/main.js",
    "dev": "pnpm build && node --env-file-if-exists=../../.env dist/src/main.js",
    "db:migrate": "node --env-file-if-exists=../../.env node_modules/prisma/build/index.js migrate deploy",
    "test": "node --env-file-if-exists=../../.env --test --test-concurrency=1 \"dist/test/*.test.js\""
  },
  "dependencies": {
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/jwt": "12.0.3",
    "@nestjs/platform-express": "12.1.3",
    "@nestjs/throttler": "6.7.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "24.19.2",
    "@types/pg": "8.15.5",
    "pg": "8.23.1",
    "prisma": "7.10.0",
    "typescript": "5.9.3"
  }
}
