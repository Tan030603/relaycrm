{
  "name": "api",
  "private": true,
  "version": "0.1.0",
  "files": [
    "dist",
    "prisma",
    "prisma.config.ts"
  ],
  "scripts": {
    "generate": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.json",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "start": "node dist/src/main.js",
    "dev": "pnpm build && node --env-file-if-exists=../../.env dist/src/main.js",
    "db:migrate": "node --env-file-if-exists=../../.env node_modules/prisma/build/index.js migrate deploy",
    "test": "node --env-file-if-exists=../../.env --env-file-if-exists=../../.env.test --test --test-concurrency=1 \"dist/test/*.test.js\"",
    "worker": "node --env-file-if-exists=../../.env dist/src/worker.js",
    "seed": "node --env-file-if-exists=../../.env dist/src/seed.js",
    "db:migrate:test": "node --env-file-if-exists=../../.env --env-file-if-exists=../../.env.test node_modules/prisma/build/index.js migrate deploy"
  },
  "dependencies": {
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/jwt": "12.0.3",
    "@nestjs/platform-express": "12.1.3",
    "@nestjs/throttler": "6.7.1",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/instrumentation-express": "0.71.1",
    "@opentelemetry/instrumentation-http": "0.223.0",
    "@opentelemetry/instrumentation-ioredis": "0.71.0",
    "@opentelemetry/instrumentation-pg": "0.76.0",
    "@opentelemetry/sdk-node": "0.223.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bullmq": "6.3.17",
    "graphql": "17.0.2",
    "ioredis": "6.0.0",
    "nodemailer": "10.1.7",
    "pino": "10.4.0",
    "prisma": "7.10.1",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "pg": "8.23.1",
    "typescript": "5.9.3"
  }
}
