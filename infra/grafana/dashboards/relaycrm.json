{
 "uid": "relaycrm-overview",
 "title": "RelayCRM overview",
 "schemaVersion": 41,
 "refresh": "10s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "API request rate by status",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 0
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (status) (rate(relaycrm_http_request_duration_seconds_count[1m]))",
     "legendFormat": "{{status}}"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "API latency p50 / p95 / p99",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 0
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum by (le) (rate(relaycrm_http_request_duration_seconds_bucket[5m])))",
     "legendFormat": "p50"
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(relaycrm_http_request_duration_seconds_bucket[5m])))",
     "legendFormat": "p95"
    },
    {
     "refId": "C",
     "expr": "histogram_quantile(0.99, sum by (le) (rate(relaycrm_http_request_duration_seconds_bucket[5m])))",
     "legendFormat": "p99"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Queue depth (waiting + delayed)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (queue) (relaycrm_queue_depth{state=~\"waiting|delayed\"})",
     "legendFormat": "{{queue}}"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Oldest waiting job age (alert > 60 s)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "relaycrm_queue_oldest_job_age_seconds{queue!=\"dlq\"}",
     "legendFormat": "{{queue}}"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Automation runs finished",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 16
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (status) (rate(relaycrm_runs_total[5m])) * 60",
     "legendFormat": "{{status}} / min"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Outbox events relayed",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 16
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "rate(relaycrm_events_relayed_total[1m])",
     "legendFormat": "events / s"
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "API 5xx ratio (alert > 2%)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 24
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(relaycrm_http_request_duration_seconds_count{status=~\"5..\"}[5m])) / sum(rate(relaycrm_http_request_duration_seconds_count[5m]))",
     "legendFormat": "5xx ratio"
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Node event loop lag p99",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 24
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "nodejs_eventloop_lag_p99_seconds",
     "legendFormat": "{{job}}"
    }
   ]
  }
 ]
}