{
  "name": "relaycrm",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24.7"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "db:migrate": "pnpm --filter api db:migrate",
    "dev:api": "pnpm --filter api dev",
    "dev:web": "pnpm --filter web dev",
    "lint": "eslint .",
    "dev:worker": "pnpm --filter api worker",
    "seed": "pnpm --filter api seed",
    "db:migrate:test": "pnpm --filter api db:migrate:test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "eslint-plugin-vue": "10.11.1",
    "typescript-eslint": "8.71.2"
  }
}
